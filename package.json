{
  "name": "@adeyanjufuhad/repospec",
  "version": "0.1.0",
  "description": "Local, token-budgeted repository context for AI coding assistants",
  "type": "module",
  "bin": {
    "repospec": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "ui"
  ],
  "scripts": {
    "build": "npm run build --workspace ui",
    "build:cli": "tsup src/cli.ts src/index.ts --format esm --dts --clean",
    "dev": "npm run dev --workspace ui",
    "build:ui": "npm run build --workspace ui",
    "start": "npm run start --workspace ui",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace ui",
    "pretest": "npm run build:cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build:cli && node scripts/package-smoke.mjs",
    "prepack": "npm run build:cli"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeyanjufuhad/RepoSpec.git"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@mrleebo/prisma-ast": "^0.16.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "gpt-tokenizer": "^4.0.0",
    "picomatch": "^4.0.7",
    "tar-stream": "^3.2.2",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/picomatch": "^4.0.3",
    "@types/tar-stream": "^3.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
